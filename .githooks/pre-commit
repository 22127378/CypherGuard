#!/usr/bin/env bash
# Block conflict markers, debugger statements and secret/runtime files.
set -euo pipefail

status=0
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

while IFS= read -r f; do
  base="$(basename "$f")"
  case "$base" in
    terraform.tfvars|*.auto.tfvars|backend.hcl|*.tfstate|*.tfstate.*|tfplan|*.pem|.env)
      echo "pre-commit: refusing to commit $f (secret or runtime file)" >&2
      status=1
      continue ;;
  esac
  case "$f" in
    */.terraform/*|.terraform/*)
      echo "pre-commit: refusing to commit $f (.terraform cache)" >&2
      status=1
      continue ;;
  esac

  # Check the staged content, not the working tree.
  content="$(git show ":$f" 2>/dev/null || true)"
  if grep -qE '^(<<<<<<<|>>>>>>>)( |$)' <<<"$content"; then
    echo "pre-commit: conflict marker in $f" >&2
    status=1
  fi
  # debugger; is a JavaScript statement; only check JS/TS sources.
  case "$f" in
    *.js|*.mjs|*.cjs|*.jsx|*.ts|*.tsx)
      if grep -qE '(^|[^[:alnum:]_])debugger;' <<<"$content"; then
        echo "pre-commit: 'debugger;' in $f" >&2
        status=1
      fi ;;
  esac
done <<<"$staged"

exit $status
