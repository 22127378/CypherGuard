#!/usr/bin/env bash
# Enforce "[NAMESPACE] Short, clear description" on the first line.
set -euo pipefail

msg_file="$1"
first="$(grep -v '^#' "$msg_file" | head -n1)"

# Commits generated by git itself.
if [[ "$first" =~ ^(Merge|Revert|fixup!|squash!|amend!)\  ]]; then
  exit 0
fi

fail() {
  echo "commit-msg: $1" >&2
  echo "  got:      $first" >&2
  echo "  expected: [NAMESPACE] Short, clear description (see .claude/skills/commit/SKILL.md)" >&2
  exit 1
}

namespaces="ADD|FEATURE|DELETE|REFACTOR|FIX|DOCS|TEST|CONFIG|STYLE|PERF|BUILD|CI"

[[ "$first" =~ ^\[($namespaces)\]\ (.+)$ ]] || fail "first line must start with [NAMESPACE] using one of: ${namespaces//|/, }"
desc="${BASH_REMATCH[2]}"

[ "${#first}" -le 72 ] || fail "first line is ${#first} characters (max 72)"
[[ "$first" != *. ]] || fail "first line must not end with a period"
[[ "$desc" =~ ^[A-Z] ]] || fail "description must start with a capitalised imperative verb (Add, Fix, Remove...)"

words=$(wc -w <<<"$desc")
[ "$words" -ge 3 ] || fail "description is too short (at least 3 words)"

shopt -s nocasematch
if [[ "$desc" =~ ^(update|fix|change|edit|modify)\ (code|bug|bugs|stuff|things|files?)$ ]] \
  || [[ "$desc" =~ ^(wip|misc|minor changes|small fixes|various fixes)$ ]]; then
  fail "description is too generic; say what changed and where"
fi
exit 0
