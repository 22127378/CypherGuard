terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.80"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.6"
    }
  }

  # Partial config: values come from backend.hcl (generated by infra/bootstrap).
  backend "s3" {}
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project     = "CipherGuard"
      Environment = "lab"
      ManagedBy   = "terraform"
      # Used to find leftovers after destroy:
      # aws resourcegroupstaggingapi get-resources --tag-filters Key=Project,Values=CipherGuard
      Cleanup = "destroy-after-session"
    }
  }
}
