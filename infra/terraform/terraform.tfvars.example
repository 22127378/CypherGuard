# Copy to terraform.tfvars (git-ignored) and fill in.
admin_cidr = "203.0.113.10/32" # curl -s https://checkip.amazonaws.com

# Your IAM identity, so kubectl works if the pipeline created the cluster:
# aws sts get-caller-identity --query Arn --output text
cluster_admin_arns = ["arn:aws:iam::123456789012:user/you"]

# Optional overrides
# cluster_version     = "1.33"
# node_instance_types = ["t3.large"]
