<!-- cipherguard:aws:begin -->
<!-- Managed by scripts/wazuh-sync.sh; edits here are overwritten. -->
<ossec_config>
  <wodle name="aws-s3">
    <disabled>no</disabled>
    <!-- EKS audit lands in CloudWatch within seconds; poll often for the 60 s target. -->
    <interval>30s</interval>
    <run_on_start>yes</run_on_start>
    <skip_on_error>yes</skip_on_error>
    <!-- cipherguard:cloudtrail:begin -->
    <bucket type="cloudtrail">
      <name>__CLOUDTRAIL_BUCKET__</name>
      <regions>__REGION__</regions>
    </bucket>
    <!-- cipherguard:cloudtrail:end -->
    <service type="cloudwatchlogs">
      <aws_log_groups>__EKS_LOG_GROUP__</aws_log_groups>
      <regions>__REGION__</regions>
    </service>
    <!-- cipherguard:guardduty:begin -->
    <service type="cloudwatchlogs">
      <aws_log_groups>__GUARDDUTY_LOG_GROUP__</aws_log_groups>
      <regions>__REGION__</regions>
    </service>
    <!-- cipherguard:guardduty:end -->
  </wodle>
</ossec_config>
<!-- cipherguard:aws:end -->
